# Codificación y formato uniformes para todos los archivos del proyecto (UTF-8, saltos LF).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# El CSV de la matriz lleva BOM a propósito: así Excel abre las tildes correctamente.
[docs/07-matriz-trazabilidad.csv]
charset = utf-8-bom
