{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abc-software.example/schemas/operaciones.schema.json",
  "title": "DTO-operaciones · Resumen diario, Comunicación de baja, Errores",
  "$defs": {
    "ResumenDiarioRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fechaReferencia"],
      "properties": {
        "fechaReferencia": { "type": "string", "format": "date", "description": "Fecha de emisión de las boletas a informar." }
      },
      "x-reglas": ["RN-006"]
    },
    "ComunicacionBajaRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentos"],
      "properties": {
        "documentos": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tipoDocumento", "serie", "correlativo", "motivo"],
            "properties": {
              "tipoDocumento": { "type": "string", "enum": ["01", "07", "08"] },
              "serie": { "$ref": "common.schema.json#/$defs/Serie" },
              "correlativo": { "$ref": "common.schema.json#/$defs/Correlativo" },
              "motivo": { "type": "string", "minLength": 1, "maxLength": 100 }
            }
          }
        }
      },
      "x-reglas": ["RN-007"]
    },
    "LoteEnvioResponse": {
      "type": "object",
      "required": ["id", "tipo", "ticket", "estado"],
      "properties": {
        "id": { "type": "string", "pattern": "^(RC|RA)-[0-9]{8}-[0-9]{1,5}$", "description": "RC = resumen diario; RA = comunicación de baja." },
        "tipo": { "type": "string", "enum": ["RESUMEN_DIARIO", "COMUNICACION_BAJA"] },
        "ticket": { "type": "string" },
        "estado": { "type": "string", "enum": ["PENDIENTE", "EN_PROCESO", "ACEPTADO", "RECHAZADO"] },
        "resultadoSunat": { "$ref": "comprobante.schema.json#/$defs/ResultadoSunat" }
      }
    },
    "Problema": {
      "type": "object",
      "description": "RFC 7807 (application/problem+json) extendido.",
      "required": ["type", "title", "status", "codigo"],
      "properties": {
        "type": { "type": "string", "format": "uri-reference" },
        "title": { "type": "string" },
        "status": { "type": "integer", "minimum": 400, "maximum": 599 },
        "codigo": { "type": "string", "enum": ["RUC_INVALIDO", "DOC_INVALIDO", "ADQUIRENTE_NO_VALIDO", "UBIGEO_INVALIDO", "SERIE_INVALIDA", "TOTALES_INCONSISTENTES", "ISC_SIN_PARAMETRO", "CORRELATIVO_DUPLICADO", "COMPROBANTE_NO_ENCONTRADO", "ESTADO_NO_PERMITIDO", "SUNAT_RECHAZO", "SUNAT_NO_DISPONIBLE", "XML_INVALIDO", "CERTIFICADO_INVALIDO", "VALIDACION_ESQUEMA"] },
        "detail": { "type": "string" },
        "errores": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["campo", "regla", "mensaje"],
            "properties": {
              "campo": { "type": "string", "description": "JSON Pointer al campo del request." },
              "regla": { "type": "string", "description": "ID RN-nnn." },
              "mensaje": { "type": "string" },
              "xpathUbl": { "type": "string", "description": "XPath UBL afectado (ver matriz de trazabilidad)." }
            }
          }
        }
      }
    }
  }
}
