{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Generar factura XML de ejemplo y validar contra el XSD",
      "type": "debugpy",
      "request": "launch",
      "module": "facturacion_xml",
      "env": { "PYTHONPATH": "${workspaceFolder}/src", "PYTHONUTF8": "1" },
      "console": "integratedTerminal"
    },
    {
      "name": "Pruebas unitarias de generación XML",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "-s", "tests/generacion_xml", "-t", ".", "-v"],
      "console": "integratedTerminal"
    }
  ]
}
